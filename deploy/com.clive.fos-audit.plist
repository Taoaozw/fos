<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.clive.fos-audit</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/clive/project/clive/fos/deploy/fos-audit.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>FOS_HOME</key>
    <string>/Users/clive/.fos</string>
    <key>FOS_GIT_ROOT</key>
    <string>/Users/clive/project/clive</string>
    <key>FOS_AUDIT_MODEL</key>
    <string>gpt-6.2-sol</string>
    <key>FOS_AUDIT_EFFORT</key>
    <string>medium</string>
    <key>PATH</key>
    <string>/Users/clive/.local/bin:/Users/clive/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/clive/.fos/logs/fos-audit.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/clive/.fos/logs/fos-audit.err.log</string>
</dict>
</plist>
